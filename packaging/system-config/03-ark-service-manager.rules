// Hostname control for the unprivileged ARK-OS service user (@ARK_USER@).
//
// As system services running User=@ARK_USER@ there is no active login session, so
// polkit cannot authorize interactively. This rule grants the hostname actions
// connection-manager / system-manager need.
//
// It deliberately grants no systemd actions. Starting, stopping, enabling and
// disabling ARK-OS services goes through libexec/ark_service_ctl.sh via sudo, which
// only accepts services with a manifest. Polkit can't scope enable/disable to a
// unit (manage-unit-files carries no unit name, and also covers `systemctl link`),
// and systemd accepts manage-unit-files for start/stop too, so any systemd grant
// here would let the service user run a unit file of its own as root.
//
// @ARK_USER@ is resolved at build time by assemble_tree.sh.
polkit.addRule(function(action, subject) {
    if (subject.user != "@ARK_USER@") { return; }

    if (action.id == "org.freedesktop.hostname1.set-hostname" ||
        action.id == "org.freedesktop.hostname1.set-static-hostname" ||
        action.id == "org.freedesktop.hostname1.set-pretty-hostname") {
        return polkit.Result.YES;
    }
});
