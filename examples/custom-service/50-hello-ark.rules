// Lets the ARK-OS service-manager (running as @ARK_USER@) start, stop and restart
// hello-ark from the web UI. ARK-OS's own 03-ark-service-manager.rules names
// only the units it ships; other units currently get through via its broader
// manage-unit-files grant, which this rule avoids depending on.
//
// Read by polkit >= 0.106 (Pi, Modalix). Jetson's polkit 0.105 ignores .rules
// files, and ARK-OS's .pkla already covers any unit there.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "hello-ark.service" &&
        subject.user == "@ARK_USER@") {
        return polkit.Result.YES;
    }
});
